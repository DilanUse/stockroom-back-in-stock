FROM node:24-bookworm-slim
WORKDIR /app
COPY scripts/fetch-harness.mjs ./scripts/fetch-harness.mjs
RUN node scripts/fetch-harness.mjs
COPY package.json ./
COPY src/ ./src/
RUN mkdir -p /app/data && chown -R node:node /app
ENV HOST=0.0.0.0 PORT=8080 DATA_DIR=/app/data
USER node
EXPOSE 8080
CMD ["node", "src/start-demo.ts"]
